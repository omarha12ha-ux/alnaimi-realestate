rules_version = '2';// A handful of collections are intentionally world-readable because they back// the public marketing site: property listings, services, published reviews,// departments, corporate offers and technical specialties. None of them carry// client PII. Every collection that does (appointments, inquiries, support// chats, contracts, consultant notes, settings, whatsapp logs) is restricted to// administrators and owners further down.//// `firebase-rules/no-open-reads` still warns on those public collections. The// warnings are expected and reviewed; they are left visible so that a new// public read introduced later stands out in CI rather than blending in.service cloud.firestore {match /databases/{database}/documents {// Default deny catch-allmatch /{document=**} {allow read, write: if false;}// --- Helper Functions ---function isSignedIn() {return request.auth != null;}function isOwner(userId) {return isSignedIn() && request.auth.uid == userId;}// Administrators are identified by a custom claim set from a trusted// environment, or by the role already stored on their existing profile.//// The previous version also matched three hardcoded email addresses. That// published every administrator identity in a file that ships with the// source and is readable by anyone with a copy of the repository, and it// granted admin to whoever registered one of those addresses.//// Promote an administrator with://   node scripts/set-admin-claim.mjs <uid-or-email>// which sets a signed custom claim. The claim cannot be forged by the// client because it lives in the ID token, not in Firestore.function hasAdminClaim() {return request.auth.token.admin == true;}function profileRoleIsAdmin() {return exists(/databases/$(database)/documents/users/$(request.auth.uid))&& get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}function isAdmin() {return isSignedIn() && (hasAdminClaim() || profileRoleIsAdmin());}function isValidId(id) {return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');}function incoming() {return request.resource.data;}function existing() {return resource.data;}// --- Validation Blueprints ---function isValidUser(data) {return data.uid is string && data.uid.size() <= 128 &&data.email is string && data.email.size() <= 256 &&data.name is string && data.name.size() <= 128 &&data.role in ['admin', 'client'] &&data.createdAt is string &&(!data.keys().hasAll(['broker']) || data.broker is string) &&(!data.keys().hasAll(['phone']) || data.phone is string) &&(!data.keys().hasAll(['alertGovernorates']) || data.alertGovernorates is list);}function isValidProperty(data) {return data.title is string && data.title.size() <= 256 &&data.price is string && data.price.size() <= 128 &&data.location is string && data.location.size() <= 256 &&data.images is list && data.images.size() <= 20 &&data.description is string && data.description.size() <= 5000 &&data.type in ['Residential', 'Commercial', 'Land'] &&data.coordinates is list && data.coordinates.size() == 2 &&data.coordinates[0] is number && data.coordinates[1] is number &&(!data.keys().hasAll(['rooms']) || data.rooms is number) &&(!data.keys().hasAll(['status']) || data.status in ['available', 'reserved', 'sold', 'pending_review']) &&(!data.keys().hasAll(['views']) || data.views is number) &&(!data.keys().hasAll(['governorate']) || (data.governorate is string && data.governorate.size() <= 128));}// Appointments carry client names, phone numbers, emails and payment// references, so every field is bounded. The booking flow is intentionally// public (a visitor books a viewing without an account), which is why the// size limits below are what stop this collection from being usable as// free storage or a spam vector.function isValidService(data) {return data.title is string && data.title.size() <= 256 &&data.price is string && data.price.size() <= 128 &&data.description is string && data.description.size() <= 5000 &&data.category in ['legal', 'internet', 'construction'] &&data.images is list && data.images.size() <= 5 &&data.createdAt is string;}// The single source of truth for appointment writes. Every optional field is// length-capped and type-checked; an unbounded string here would let any// authenticated client grow a document without limit.function isValidAppointment(data) {return data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 128 &&data.date is string && data.date.size() <= 32 &&data.time is string && data.time.size() <= 16 &&data.createdAt is string && data.createdAt.size() <= 64 &&(data.get('status', 'pending') in ['pending', 'confirmed', 'cancelled', 'completed', 'accepted']) &&(data.get('clientEmail', null) == null || (data.clientEmail is string && data.clientEmail.size() <= 256)) &&(data.get('propertyId', null) == null || (data.propertyId is string && data.propertyId.size() <= 128)) &&(data.get('serviceId', null) == null || (data.serviceId is string && data.serviceId.size() <= 128)) &&(data.get('serviceTitle', null) == null || (data.serviceTitle is string && data.serviceTitle.size() <= 256)) &&(data.get('userId', null) == null || (data.userId is string && data.userId.size() <= 128)) &&(data.get('subTasks', null) == null || data.subTasks is list) &&(data.get('emailReminder', null) == null || data.emailReminder is bool) &&(data.get('whatsappReminder', null) == null || data.whatsappReminder is bool) &&(data.get('clientPhone', null) == null || (data.clientPhone is string && data.clientPhone.size() <= 64)) &&(data.get('reminderSent', null) == null || data.reminderSent is bool) &&(data.get('reminderSentAt', null) == null || data.reminderSentAt is string && data.reminderSentAt.size() <= 64) &&(data.get('preferredBrokerId', null) == null || data.preferredBrokerId is string && data.preferredBrokerId.size() <= 128) &&(data.get('preferredBrokerName', null) == null || data.preferredBrokerName is string && data.preferredBrokerName.size() <= 128) &&(data.get('paymentMethod', null) == null || data.paymentMethod in ['usd', 'syp', 'syriatel_cash', 'bank', 'free']) &&(data.get('syriatelSenderPhone', null) == null || data.syriatelSenderPhone is string && data.syriatelSenderPhone.size() <= 32) &&(data.get('syriatelTxId', null) == null || data.syriatelTxId is string && data.syriatelTxId.size() <= 128) &&(data.get('bankSenderName', null) == null || data.bankSenderName is string && data.bankSenderName.size() <= 128) &&(data.get('bankTxId', null) == null || data.bankTxId is string && data.bankTxId.size() <= 128) &&(data.get('bankNameFrom', null) == null || data.bankNameFrom is string && data.bankNameFrom.size() <= 128) &&(data.get('sixHourManualReminder', null) == null || data.sixHourManualReminder is bool) &&(data.get('sixHourReminderSent', null) == null || data.sixHourReminderSent is bool) &&(data.get('sixHourReminderSentAt', null) == null || data.sixHourReminderSentAt is string && data.sixHourReminderSentAt.size() <= 64) &&(data.get('archived', null) == null || data.archived is bool);}function isValidFavorite(data) {return data.propertyId is string && data.propertyId.size() <= 128 &&data.createdAt is string &&(data.get('lists', null) == null || (data.lists is list && data.lists.size() <= 20 && (data.lists.size() == 0 || (data.lists[0] is string && data.lists[0].size() <= 64))));}function isValidReview(data) {return data.userId == request.auth.uid &&data.userName is string && data.userName.size() <= 128 &&data.rating is number && data.rating >= 1 && data.rating <= 5 &&data.feedback is string && data.feedback.size() <= 2000 &&data.createdAt is string;}function isValidInquiry(data) {return data.name is string && data.name.size() <= 128 &&data.email is string && data.email.size() <= 256 &&data.subject is string && data.subject.size() <= 256 &&data.message is string && data.message.size() <= 5000 &&data.createdAt is string &&(!data.keys().hasAll(['phone']) || (data.phone is string && data.phone.size() <= 64));}function isValidNotification(data) {return data.userId is string && data.userId.size() <= 128 &&data.title is string && data.title.size() <= 256 &&data.message is string && data.message.size() <= 1000 &&data.status is string && (data.status == 'unread' || data.status == 'read') &&data.type is string && (data.type == 'appointment_accepted' || data.type == 'general' || data.type == 'property_alert') &&data.createdAt is string &&(!data.keys().hasAll(['appointmentId']) || (data.appointmentId is string && data.appointmentId.size() <= 128)) &&(!data.keys().hasAll(['propertyId']) || (data.propertyId is string && data.propertyId.size() <= 128));}function isValidNewsletterSubscription(data) {return data.email is string && data.email.size() <= 256 &&data.createdAt is string &&data.keys().hasAll(['email', 'createdAt']) && data.keys().size() == 2;}function isValidSavedSearch(data) {return data.userId == request.auth.uid &&data.name is string && data.name.size() <= 200 &&data.alertsEnabled is bool &&data.createdAt is string &&(!data.keys().hasAll(['propertyType']) || (data.propertyType is string && data.propertyType.size() <= 64)) &&(!data.keys().hasAll(['rooms']) || (data.rooms is string && data.rooms.size() <= 32)) &&(!data.keys().hasAll(['minPrice']) || (data.minPrice is string && data.minPrice.size() <= 32)) &&(!data.keys().hasAll(['maxPrice']) || (data.maxPrice is string && data.maxPrice.size() <= 32)) &&(!data.keys().hasAll(['governorate']) || (data.governorate is string && data.governorate.size() <= 128)) &&(!data.keys().hasAll(['searchQuery']) || (data.searchQuery is string && data.searchQuery.size() <= 512));}function isValidSettings(data) {return data.rate is number && data.rate > 0 &&data.updatedAt is string &&(!data.keys().hasAll(['updatedBy']) || data.updatedBy is string);}function isValidBrokerRating(data) {return data.userId == request.auth.uid &&data.userName is string && data.userName.size() <= 128 &&data.brokerName is string && data.brokerName.size() <= 128 &&data.rating is number && data.rating >= 1 && data.rating <= 5 &&data.feedback is string && data.feedback.size() <= 2000 &&data.createdAt is string;}function isValidBroker(data) {return data.name is string && data.name.size() <= 128 &&data.phone is string && data.phone.size() <= 64 &&data.email is string && data.email.size() <= 256 &&data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100 &&data.dealsCount is number && data.dealsCount >= 0 &&data.status in ['active', 'inactive'] &&data.createdAt is string;}function isValidDepartment(data) {return data.name is string && data.name.size() <= 256 &&data.supervisorName is string && data.supervisorName.size() <= 128 &&data.supervisorPhone is string && data.supervisorPhone.size() <= 64 &&data.supervisorEmail is string && data.supervisorEmail.size() <= 256 &&data.description is string && data.description.size() <= 2000 &&data.status in ['active', 'inactive'] &&data.createdAt is string;}function isValidPropertyStatusLog(data) {return data.propertyId is string && data.propertyId.size() <= 128 &&data.propertyTitle is string && data.propertyTitle.size() <= 256 &&data.governorate is string && data.governorate.size() <= 128 &&(!data.keys().hasAll(['oldStatus']) || data.oldStatus in ['available', 'reserved', 'sold', 'pending_review']) &&data.newStatus in ['available', 'reserved', 'sold', 'pending_review'] &&data.updatedAt is string;}// --- Match Rules ---match /users/{userId} {allow read: if isSignedIn();// Creating a profile: only for yourself, and the role is always forced// to 'client'. A client-supplied `role: 'admin'` is rejected outright so// registration cannot be used to self-promote.allow create: if isOwner(userId)&& isValidUser(incoming())&& incoming().role == 'client';// Updating an existing profile.//   - Admins may change anything, including roles.//   - Owners may change their own profile but must not touch `role`,//     `uid`, or `email`. Previously `allow write: if isOwner(userId)`//     let any signed-in user set their own role to 'admin' and inherit//     every admin capability in these rules.allow update: if isAdmin()|| (isOwner(userId)&& incoming().role == resource.data.role&& incoming().uid == resource.data.uid&& incoming().email == resource.data.email&& isValidUser(incoming()));allow delete: if isAdmin();match /favorites/{propertyId} {allow read: if isOwner(userId) || isAdmin();allow create, update: if isOwner(userId) && isValidFavorite(incoming()) && isValidId(propertyId);allow delete: if isOwner(userId);}}match /price_updates/{logId} {allow read: if isSignedIn();allow write: if isAdmin();}match /price_updates_log/{logId} {allow read: if isSignedIn();allow write: if isAdmin();}// A customer's chat lives at support_chats/{theirUid}; the admin console// manages every chat. Previously any signed-in user could read and rewrite// everyone's private conversation (names, phones, messages).match /support_chats/{chatId} {allow read: if isAdmin() || (isSignedIn() && chatId == request.auth.uid);allow create: if isAdmin() || (isSignedIn() && chatId == request.auth.uid);allow update: if isAdmin() || (isSignedIn() && chatId == request.auth.uid);allow delete: if isAdmin();}match /departments/{departmentId} {allow read: if true; // Publicly readable departmentsallow write: if isAdmin() && isValidDepartment(incoming());}// Appointments hold client PII (name, phone, email) and payment references.//// This collection used to be `allow read/create/update/delete: if true`,// which meant any anonymous visitor could enumerate every customer's phone// number, alter confirmed bookings, or delete records outright.//// Booking stays open to visitors by design, but everything after creation// is restricted: only an administrator may change or remove a booking, and// reads are limited to administrators and the owner of the record.match /appointments/{appointmentId} {allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);allow create: if isValidAppointment(incoming()) && isValidId(appointmentId);allow update: if isAdmin();allow delete: if isAdmin();}// The whatsapp settings document stores provider credentials// (UltraMsg token, Twilio auth token). Those are server secrets, so this// document is never readable or writable by a regular client. The server// worker reads it with admin credentials instead.match /settings/whatsapp {allow read, write: if isAdmin();}        match /settings/{settingId} {\n      allow read: if isAdmin();\n      allow write: if isAdmin();\n    }// Notes are private to their author and to administrators. Any signed-in// user could previously read and overwrite every other consultant's notes.match /consultant_notes/{noteId} {allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);allow create: if isSignedIn() && incoming().userId == request.auth.uid;allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);}// --- Added Match Rules for Core Collections ---match /brokers/{brokerId} {allow read: if isSignedIn();allow write: if isAdmin();}match /broker_ratings/{ratingId} {allow read: if true;allow create, update: if isSignedIn() && isValidBrokerRating(incoming());allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);}match /properties/{propertyId} {allow read: if true;allow write: if isAdmin();}match /services/{serviceId} {allow read: if true;allow write: if isAdmin();}match /reviews/{reviewId} {allow read: if true;allow create, update: if isSignedIn() && isValidReview(incoming());allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);}match /inquiries/{inquiryId} {allow read: if isAdmin();allow create: if isValidInquiry(incoming());allow update, delete: if isAdmin();}match /notifications/{notificationId} {allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());allow create, update: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid && isValidNotification(incoming()));allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);}match /newsletter_subscriptions/{subscriptionId} {allow read, write: if isAdmin();allow create: if isValidNewsletterSubscription(incoming());}match /saved_searches/{searchId} {allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());allow write: if isSignedIn() && incoming().userId == request.auth.uid && isValidSavedSearch(incoming());allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;}match /whatsapp_logs/{logId} {allow read, write: if isAdmin();}match /webhook_failure_trackers/{trackerId} {allow read, write: if isAdmin();}match /technical_specialties/{specialtyId} {allow read: if isSignedIn();allow write: if isAdmin();}match /property_status_logs/{logId} {allow read, write: if isAdmin();}match /contracts/{contractId} {allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());allow delete: if isAdmin();}match /corporate_deals/{dealId} {allow read: if true;allow write: if isAdmin();}}}allow read: if isAdmin();allow write: if isAdmin();\n        match /companySettings/{docId} {\n      allow read: if isAdmin();\n      allow write: if isAdmin();\n    }\n}\n}

