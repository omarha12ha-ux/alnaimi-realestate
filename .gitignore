# Local secrets. Only the template is tracked.
.env*
!.env.example

# Google/Firebase service account keys. These grant full project access and
# must never enter version control. Place them outside the repo and point
# GOOGLE_APPLICATION_CREDENTIALS at the file, or keep them in a gitignored
# `secrets/` folder.
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
secrets/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Runtime uploads produced by the server, never part of the source.
uploads/

# Android build output and caches. `android/app/src/main/assets/public` is
# regenerated by `npx cap sync` from the Vite build; committing it duplicated
# a 1.8MB minified bundle in the repository and guaranteed the app and the web
# build drifted apart.
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/local.properties
android/.idea/
*.iml

