# ==========================================================================
# شركة البراء النعيمي العقارية - متغيرات البيئة
# ==========================================================================
# انسخ هذا الملف إلى `.env` واملأ القيم. لا ترفع `.env` إلى Git أبداً.
# لتوليد سر قوي:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ==========================================================================


# --------------------------------------------------------------------------
# 1) مفاتيح الذكاء الاصطناعي والخرائط
# --------------------------------------------------------------------------
# GEMINI_API_KEY: مطلوب لاستدعاءات Gemini (الديكور، الفيديو، الاستشارة، تحليل المشاعر).
GEMINI_API_KEY=
# GOOGLE_MAPS_PLATFORM_KEY: مطلوب لخريطة Google وعرض 360 درجة.
GOOGLE_MAPS_PLATFORM_KEY=

# رابط التطبيق المستضاف (يُستخدم في الروابط الذاتية و OAuth).
APP_URL="https://example.run.app"


# --------------------------------------------------------------------------
# 2) حماية الـ API (إجباري - بدونها تُرفض كل النقاط المحمية)
# --------------------------------------------------------------------------
# INTERNAL_API_TOKEN: رمز الماكينة إلى الماكينة.
#   يستخدمه المجدول الخارجي (Cloud Scheduler / cron) للاستدعاء على /api/cron/*
#   التي تشغّل رسائل واتساب حقيقية. عيّن قيمة عشوائية 48 بايت على الأقل.
INTERNAL_API_TOKEN=

# ADMIN_API_TOKEN: رمز المشغّل (admin).
#   تستخدمه لوحة الإدارة عبر /api/whatsapp/* و /api/upload-app و /api/payment/*.
ADMIN_API_TOKEN=

# --------------------------------------------------------------------------
# 2b) قائمة البريد الإداري
# --------------------------------------------------------------------------
# ADMIN_EMAILS: البريد الإداري على الخادم، مفصولة بفواصل.
#   الخادم يتحقق من توقيع الـ ID token لدى Google أولاً، ثم يقارن البريد
#   الموجود داخله بهذه القائمة. لا يمكن تزويره بتعديل التوكن محلياً.
#   هذا ما يمنح صلاحيات /api/whatsapp/* و /api/upload-app.
ADMIN_EMAILS="omarha12ha@gmail.com"

# VITE_ADMIN_EMAILS: نفس القائمة، لكن للعرض في المتصفح فقط.
#   لا يمنح أي صلاحية: يظهر واجهة الإدارة، لكن البيانات تظل محمية
#   بـ firestore.rules وبتحقق الخادم. استعمل نفس قيمة ADMIN_EMAILS.
VITE_ADMIN_EMAILS="omarha12ha@gmail.com"


# --------------------------------------------------------------------------
# 3) حساب الخدمة للتذكيرات الآلية (اختياري)
# --------------------------------------------------------------------------
# إذا لم تُعيّن هذين المتغيرين، يعمل الخادم لكن التذكيرات الآلية معطّلة.
# الإنشاء: Firebase Console > Authentication > Users > Add user،
# ثم اضبط users/{uid}.role = 'admin' لهذا الحساب.
# لأسباب أمنية، لا ينشئ الخادم هذا الحساب تلقائياً.
FIREBASE_SERVICE_EMAIL=
FIREBASE_SERVICE_PASSWORD=

# --------------------------------------------------------------------------
# 4) واتساب
# --------------------------------------------------------------------------
# رقم المرسل (بصيغة دولية، مثال: +9639xxxxxxx)
SENDER_WHATSAPP_NUMBER="0945430030"

# المزوّد: simulation | ultramsg | twilio | custom_http
# simulation = يسجّل في السجل فقط دون إرسال حقيقي (افتراضي، مناسب للتجربة)
WHATSAPP_PROVIDER="simulation"

# إعدادات UltraMsg (اختياري)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# إعدادات Twilio (اختياري)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SENDER_NUMBER=""

# إعدادات Webhook مخصص (اختياري)
CUSTOM_WHATSAPP_URL=""
CUSTOM_WHATSAPP_METHOD="POST"
CUSTOM_WHATSAPP_HEADERS="{\"Content-Type\":\"application/json\"}"
CUSTOM_WHATSAPP_BODY="{\"to\":\"{phone}\",\"body\":\"{message}\"}"


# --------------------------------------------------------------------------
# 5) مدفوعات Stripe
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# رسوم الحجز (بالسنت). تُستخدم كمبلغ افتراضي عند عدم وجود سعر في الموعد.
# 100 = 1.00 دولار. اضبطها على 0 لتعطيل الدفع للمواعيد بلا سعر.
BOOKING_FEE_CENTS="0"

# رمز العملة
STRIPE_CURRENCY="usd"
